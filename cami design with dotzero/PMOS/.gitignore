# Secrets. Never commit these, this repo is shared.
.env
.env.*
!.env.example

# mySecond sync internals. Machine-local state and conflict backups, not artifacts.
.claude/sync-state.json
.claude/sync-conflicts/
.claude/settings.local.json

# Slite notes pulled at session start. Generated by .claude/hooks/slite-pull.sh,
# rewritten every session including a fresh timestamp in INDEX.md, so the whole
# folder is ignored. A clone has no context/slite/ until the hook first runs.
context/slite/

# OS noise
.DS_Store
